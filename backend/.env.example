# Backend environment. Copy to .env — settings.py loads it automatically.
# Real environment variables always win over anything set here.
#
# CRITICAL: every secret below has a development-only fallback in
# settings.py. The moment you set DEBUG=False, the app REFUSES TO START
# unless SECRET_KEY and CRYPTOGRAPHY_KEYS are real values, so you cannot
# accidentally boot production with a key that's public in this repo.

# --- Core ---
DEBUG=True
# Comma-separated. Must NOT be '*' when DEBUG=False.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated. Must include your frontend's exact origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required when DEBUG=False. Generate:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# SECRET_KEY=

# --- Encryption ---
# Comma-separated Fernet keys, NEWEST FIRST. The first encrypts; all of them
# are tried when decrypting, which is what makes rotation possible.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# CRYPTOGRAPHY_KEYS=
#
# Losing every key here makes all stored phone numbers and messages
# permanently unreadable. Back this up in a password manager.

# --- Database ---
# Defaults to backend/db.sqlite3.
# DATABASE_PATH=

# --- Cache / rate limiting ---
# Throttle counters live in the cache, so the cache backend decides whether
# rate limits are actually global. LocMemCache is per-process, which makes
# every limit N times looser than configured under gunicorn.
# Leave unset and you get a local file cache (shared across workers on one
# box, resets on restart). Set REDIS_URL for real shared limiting.
# REDIS_URL=redis://localhost:6379/0
# CACHE_KEY_PREFIX=bulk-sender

# --- Abandoned send recovery ---
# A send runs on a thread inside a web worker, so gunicorn recycling a worker
# or a reboot can kill it mid-send. After this many seconds with no progress,
# the campaign is presumed dead and marked failed so you can start another.
# Default 45 minutes — longer than the 10-minute login timeout plus pacing on
# a large campaign.
# CAMPAIGN_STALE_AFTER_SECONDS=2700

# --- Limits ---
# Max size of a single uploaded image/video, in bytes. Default 25MB.
# MAX_MEDIA_BYTES=26214400
# Contacts one user may queue per day. Default 20000.
# THROTTLE_SEND_QUOTA=20000/day
# THROTTLE_LOGIN=10/minute
# THROTTLE_REGISTER=5/hour

# --- WhatsApp automation ---
# Headed by default: WhatsApp Web is unreliable about accepting the
# linked-device handshake from a headless browser. Set true only if you're
# running somewhere with no display and accept the login may fail.
WHATSAPP_HEADLESS=false
# Path to a real Chrome/Edge/Brave install, if auto-detection misses it.
# WHATSAPP_BROWSER_PATH=
# Write a screenshot on each automation step. These capture a logged-in
# WhatsApp session, so they go to WHATSAPP_DEBUG_DIR, never MEDIA_ROOT.
# WHATSAPP_DEBUG=false
# WHATSAPP_DEBUG_DIR=
# WHATSAPP_SESSION_DIR=

# Test-only escape hatch: marks every contact sent without contacting WhatsApp.
# Used by smoke.py so the API can be exercised without launching a browser at
# web.whatsapp.com. Never set this in production.
# WHATSAPP_DISABLE_AUTOMATION=false

# Test-only: marks every contact sent without contacting WhatsApp at all.
# Used by smoke.py so the API can be exercised without launching a browser.
# Never set this in production.
# WHATSAPP_DISABLE_AUTOMATION=false

LOG_LEVEL=INFO