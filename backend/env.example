# Copy this file to `.env` and fill in real values before running the backend.
# Never commit the actual .env file (it's already in .gitignore).
#
# Django doesn't auto-load .env files — either export these manually in your
# shell, use `python-dotenv` / `django-environ` locally, or set them as real
# environment variables in your host's dashboard (e.g. Render).

# --- Django core ---
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Encryption ---
# Fernet key used to encrypt phone numbers and message text at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when DEBUG=False — the app will refuse to start without it.
CRYPTOGRAPHY_KEY=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
