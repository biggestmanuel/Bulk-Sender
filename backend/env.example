# Copy this file to `.env` and fill in real values before running the backend.
# Never commit the actual .env file (it's already in .gitignore).
#
# NOTE: neither python-dotenv nor django-environ is in requirements.txt,
# so Django will NOT auto-load a `.env` file on its own. For local dev,
# export these manually in your shell before running manage.py, e.g.:
#   export CRYPTOGRAPHY_KEY=your-key-here
# In production (Render, etc.), set them as real environment variables in
# your host's dashboard instead — this file is just documentation either way.

# --- Django core ---
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Encryption ---
# Fernet key used to encrypt phone numbers and message text at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when DEBUG=False — the app will refuse to start without it.
CRYPTOGRAPHY_KEY=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
