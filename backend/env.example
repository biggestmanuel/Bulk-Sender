# Copy this file to `.env` and fill in real values before running the backend.
# Never commit the actual .env file (it's already in .gitignore).
#
# NOTE: Django does NOT auto-load .env files, and this project does not
# install python-dotenv or django-environ (check requirements.txt — neither
# is listed). So these values must be set as real environment variables:
#   - locally: export them in your shell before running manage.py, or use
#     a tool like `direnv`
#   - in production (Render, etc.): set them in your host's dashboard

# --- Django core ---
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Encryption ---
# Fernet key used to encrypt phone numbers and message text at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when DEBUG=False — the app will refuse to start without it.
CRYPTOGRAPHY_KEY=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
