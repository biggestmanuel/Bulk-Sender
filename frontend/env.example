# Frontend environment. Copy to .env (or .env.local) and fill it in.
#
# Vite only exposes variables prefixed with VITE_ to client code, and only
# those present at BUILD time — so this must be set wherever the frontend is
# built, not just in a local .env file.
#
# The URL of the Django backend's /api/ root, with no trailing slash.
# Leave unset for local development against http://127.0.0.1:8000/api
# VITE_API_BASE_URL=https://your-backend.onrender.com/api